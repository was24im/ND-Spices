# ==============================================================================
# ND SPICES - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# App Configuration
NEXT_PUBLIC_APP_NAME="ND Spices"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=499

# Neon PostgreSQL Database URL (Serverless Pooled & Direct)
# Obtain from Neon Console: https://console.neon.tech
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth.js / Auth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate_a_random_32_character_string_here"

# Admin Initial Credentials
ADMIN_EMAIL="admin@ndspices.com"
ADMIN_PASSWORD="supersecretadminpassword"

# Razorpay Payment Gateway (Test / Live credentials)
# Obtain from Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecretHere"

# Email Notifications (Resend / Nodemailer)
RESEND_API_KEY="re_123456789_abcdef"
EMAIL_FROM="ND Spices <orders@ndspices.com>"
SUPPORT_EMAIL="support@ndspices.com"

# Cloudinary / Image Storage (Optional)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
