// ND Spices - Prisma Schema for Neon Serverless PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  STAFF
  CUSTOMER
  ADMIN
  USER
}

enum OrderStatus {
  PLACED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  CONVERTED
  LOST
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum MediaType {
  IMAGE
  BANNER
  LOGO
  DOCUMENT
}

model User {
  id           String         @id @default(cuid())
  name         String?
  email        String         @unique
  passwordHash String?
  role         Role           @default(CUSTOMER)
  phone        String?
  image        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  addresses    Address[]
  orders       Order[]
  cartItems    CartItem[]
  wishlist     WishlistItem[]
  reviews      Review[]
  assignedLeads Lead[]        @relation("AssignedStaff")
  leadNotes    LeadNote[]
  invoicesCreated Invoice[]   @relation("InvoiceCreator")
  auditLogs    AuditLog[]

  @@map("users")
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  fullName   String
  street     String
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  phone      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@map("addresses")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  image       String?
  description String?   @db.Text
  displayOrder Int      @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String         @db.Text
  categoryId  String
  images      String[]       // PostgreSQL native text array
  origin      String         // e.g. "Idukki Hills, Kerala", "Pampore, Kashmir"
  isFeatured  Boolean        @default(false)
  inStock     Boolean        @default(true)
  isVisible   Boolean        @default(true)
  rating      Float          @default(5.0)
  numReviews  Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  category    Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  reviews     Review[]
  wishlist    WishlistItem[]

  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id              String      @id @default(cuid())
  productId       String
  weight          String      // e.g., "100g", "250g", "500g", "1kg"
  price           Decimal     @db.Decimal(10, 2)
  discountedPrice Decimal?    @db.Decimal(10, 2)
  stockQuantity   Int         @default(0)
  sku             String      @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model CartItem {
  id               String         @id @default(cuid())
  userId           String
  productVariantId String
  quantity         Int            @default(1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([userId, productVariantId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  userId            String?
  addressId         String?
  totalAmount       Decimal       @db.Decimal(10, 2)
  discountAmount    Decimal       @default(0) @db.Decimal(10, 2)
  shippingFee       Decimal       @default(0) @db.Decimal(10, 2)
  finalAmount       Decimal       @db.Decimal(10, 2)
  paymentMethod     PaymentMethod @default(RAZORPAY)
  paymentStatus     PaymentStatus @default(PENDING)
  orderStatus       OrderStatus   @default(PLACED)
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  address           Address?      @relation(fields: [addressId], references: [id], onDelete: SetNull)
  orderItems        OrderItem[]

  @@index([userId])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id               String         @id @default(cuid())
  orderId          String
  productVariantId String
  quantity         Int
  unitPrice        Decimal        @db.Decimal(10, 2)
  totalPrice       Decimal        @db.Decimal(10, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Float?
  discountAmount  Decimal?  @db.Decimal(10, 2)
  minOrderValue   Decimal?  @db.Decimal(10, 2)
  maxDiscount     Decimal?  @db.Decimal(10, 2)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  usageLimit      Int?
  usageCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("coupons")
}

model Review {
  id                 String   @id @default(cuid())
  productId          String
  userId             String
  rating             Int      @default(5)
  comment            String   @db.Text
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("reviews")
}

// ----------------------------------------------------
// CRM: Leads & Lead Follow-up Notes
// ----------------------------------------------------
model Lead {
  id              String      @id @default(cuid())
  name            String
  email           String
  phone           String?
  company         String?
  source          String?     @default("Website Inquiry")
  status          LeadStatus  @default(NEW)
  spiceInterest   String?     // e.g. "Bulk Saffron 1kg", "Cardamom B2B Wholesale"
  estimatedValue  Decimal?    @db.Decimal(10, 2)
  assignedToId    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  assignedTo      User?       @relation("AssignedStaff", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes           LeadNote[]

  @@index([assignedToId])
  @@index([status])
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String
  note      String   @db.Text
  createdAt DateTime @default(now())

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_notes")
}

// ----------------------------------------------------
// Billing & Invoices
// ----------------------------------------------------
model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  customerName    String
  customerEmail   String
  customerPhone   String?
  billingAddress  String        @db.Text
  subtotal        Decimal       @db.Decimal(10, 2)
  taxPercent      Float         @default(5.0)
  taxAmount       Decimal       @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(10, 2)
  finalAmount     Decimal       @db.Decimal(10, 2)
  status          InvoiceStatus @default(ISSUED)
  dueDate         DateTime?
  paymentMethod   String        @default("Bank Transfer (NEFT/RTGS)")
  notes           String?       @db.Text
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  createdBy       User?         @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items           InvoiceItem[]

  @@index([invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// ----------------------------------------------------
// CMS & Website Customization Engine
// ----------------------------------------------------
model WebsiteContent {
  id        String   @id @default(cuid())
  key       String   @unique // e.g., "homepage.hero", "homepage.story", "announcement"
  section   String   // e.g. "hero", "about", "banner", "footer"
  content   Json     // structured JSON payload
  updatedAt DateTime @updatedAt

  @@map("website_content")
}

model ThemeSettings {
  id             String   @id @default("default-theme")
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String   @default("#7B241C") // Deep Cinnamon
  secondaryColor String   @default("#196F3D") // Cardamom Emerald
  accentColor    String   @default("#D4AC0D") // Golden Turmeric
  backgroundColor String  @default("#FDFBF7") // Warm Cream
  textColor      String   @default("#1E1E1E") // Dark Charcoal
  fontFamily     String   @default("Playfair Display") // Serif / Sans / Playfair
  borderRadius   String   @default("1.5rem") // rounded-3xl / 1rem / 0.5rem
  buttonStyle    String   @default("pill") // pill / rounded / sharp
  heroBannerUrl  String?
  updatedAt      DateTime @updatedAt

  @@map("theme_settings")
}

model WebsiteSettings {
  id               String   @id @default("default-settings")
  storeName        String   @default("ND Spices")
  tagLine          String   @default("100% Single-Origin Pure Heritage Spices & Aromatics")
  contactEmail     String   @default("hello@ndspices.com")
  contactPhone     String   @default("+91 98450 12345")
  address          String   @default("Wayanad Estate Hub, Kerala 673121, India")
  gstNumber        String   @default("32AABCU9603R1ZM")
  fssaiNumber      String   @default("11321004000182")
  instagramUrl     String?  @default("https://instagram.com/ndspices")
  facebookUrl      String?  @default("https://facebook.com/ndspices")
  whatsappNumber   String?  @default("+919845012345")
  isWhatsappEnabled Boolean @default(true)
  freeShippingMin  Decimal  @default(499) @db.Decimal(10, 2)
  flatShippingRate Decimal  @default(60) @db.Decimal(10, 2)
  taxRatePercent   Float    @default(5.0)
  isCodEnabled     Boolean  @default(true)
  isRazorpayEnabled Boolean @default(true)
  seoTitle         String   @default("ND Spices | 100% Single-Origin Pure Heritage Spices & Aromatics")
  seoDescription   String   @default("Pure single-origin Indian spices direct from multi-generational heritage estates in Kerala and Kashmir. Cold-ground, lab-tested, and chemical-free.")
  seoKeywords      String   @default("single origin spices, kashmiri saffron, wayanad black pepper, green cardamom, pure turmeric")
  ogImageUrl       String?  @default("https://images.unsplash.com/photo-1596040033229-a9821ebd058d?auto=format&fit=crop&q=80&w=1200")
  updatedAt        DateTime @updatedAt

  @@map("website_settings")
}

// ----------------------------------------------------
// Media Asset Library
// ----------------------------------------------------
model MediaAsset {
  id        String    @id @default(cuid())
  title     String
  url       String
  type      MediaType @default(IMAGE)
  category  String    @default("products") // logos, banners, products, terroirs, general
  sizeBytes Int?
  createdAt DateTime  @default(now())

  @@index([category])
  @@map("media_assets")
}

// ----------------------------------------------------
// Audit Logs (Super Admin & Staff Action History)
// ----------------------------------------------------
model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  userName      String?
  userEmail     String?
  userRole      String?
  action        String   // e.g. "UPDATE_PRODUCT", "CHANGE_THEME", "UPDATE_HOMEPAGE", "CREATE_INVOICE"
  module        String   // e.g. "PRODUCTS", "THEME", "CMS", "BILLING", "CRM", "SETTINGS"
  targetId      String?  // ID of affected entity
  targetName    String?  // Name of affected entity
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}
